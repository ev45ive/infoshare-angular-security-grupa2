{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@spartan-ng/helm/textarea": [
        "./shared/ui/textarea/src/index.ts"
      ],
      "@spartan-ng/helm/utils": [
        "./shared/ui/utils/src/index.ts"
      ],
      "@spartan-ng/helm/button": [
        "./shared/ui/button/src/index.ts"
      ],
      "@spartan-ng/helm/card": [
        "./shared/ui/card/src/index.ts"
      ],
      "@spartan-ng/helm/input": [
        "./shared/ui/input/src/index.ts"
      ],
      "@spartan-ng/helm/label": [
        "./shared/ui/label/src/index.ts"
      ],
      "@spartan-ng/helm/badge": [
        "./shared/ui/badge/src/index.ts"
      ],
      "@spartan-ng/helm/alert": [
        "./shared/ui/alert/src/index.ts"
      ]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./projects/__experiments/tsconfig.app.json"
    },
    {
      "path": "./projects/xss/tsconfig.app.json"
    },
    {
      "path": "./projects/idor/tsconfig.app.json"
    },
    {
      "path": "./projects/site/tsconfig.app.json"
    }
  ]
}
